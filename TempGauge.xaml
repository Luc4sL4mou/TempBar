<UserControl x:Class="TempBar.TempGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44">

    <UserControl.Resources>
        <!-- Texto branco com sombra escura para ler sobre qualquer fundo -->
        <Style x:Key="GaugeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" Style="{StaticResource GaugeText}" FontSize="11"
                   Margin="6,0,0,0" VerticalAlignment="Center" Text="CPU" />

        <Grid x:Name="BarArea" Grid.Column="1" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="10" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>

            <!-- Barra com gradiente verde -> azul -> vermelho -->
            <Border Grid.Row="1" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#2ECC71" Offset="0" />
                        <GradientStop Color="#3498DB" Offset="0.5" />
                        <GradientStop Color="#E74C3C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Mínimo (esquerda) e máximo (direita) -->
            <TextBlock x:Name="MinText" Grid.Row="2" Style="{StaticResource GaugeText}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Text="30°" />
            <TextBlock x:Name="MaxText" Grid.Row="2" Style="{StaticResource GaugeText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="90°" />

            <!-- Apontador e valor atual -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <TextBlock x:Name="ValueText" Style="{StaticResource GaugeText}"
                           Width="40" TextAlignment="Center" Canvas.Top="1" Text="--">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ValueShift" X="-20" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                           Fill="White" Canvas.Left="-1.5" Canvas.Top="15">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.9" />
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="PointerShift" X="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
